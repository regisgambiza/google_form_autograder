/* =========================================================================
   Google Form Autograder — "Classic Utility" GUI stylesheet
   Design language: classic Windows desktop utility (IDM-style): light gray
   chrome (#F0F0F0), white workspace, small system text, thin 1px gray
   borders, flat rectangular controls, dense tables, colorful toolbar icons.
   Brand accents (indigo/green/orange) are reserved for status + primary
   actions only.
   ========================================================================= */

/* ---- base ------------------------------------------------------------- */
* { outline: none; }
QMainWindow, QDialog, QMessageBox {
    background: #f0f0f0;
    color: #000000;
}
QWidget {
    color: #000000;
    font-family: "Segoe UI", "Tahoma", sans-serif;
    font-size: 9pt;
}
QLabel#Muted, QLabel#CardCaption, QLabel#StatSub, QLabel#QueueMeta,
QLabel#FeedMeta, QLabel#EtaLabel, QLabel#ProviderKV, QLabel#ModelKey,
QLabel#LegendText, QLabel#StripMuted {
    color: #808080;
    font-size: 8.5pt;
}
QLabel#PageTitle {
    color: #000000;
    font-size: 11pt;
    font-weight: 700;
}
QLabel#Headline {
    color: #000000;
    font-size: 12pt;
    font-weight: 700;
}
QLabel#Subline { color: #585858; font-size: 9pt; }
QLabel#SectionTitle { color: #000000; font-size: 10pt; font-weight: 700; }
QLabel#StatValue { color: #000000; font-size: 12pt; font-weight: 700; }

/* ---- menu bar ----------------------------------------------------------- */
QMenuBar {
    background: #f0f0f0;
    border-bottom: 1px solid #c8c8c8;
    padding: 1px 4px;
    color: #000000;
    font-size: 9pt;
}
QMenuBar::item {
    padding: 4px 9px;
    background: transparent;
    border-radius: 0;
}
QMenuBar::item:selected { background: #e0e0e0; color: #000000; }
QMenuBar::item:pressed { background: #d4d4d4; }

/* ---- toolbar (large icon + label underneath, IDM style) ----------------- */
QToolBar {
    background: #f0f0f0;
    border: 0;
    border-bottom: 1px solid #c8c8c8;
    padding: 4px 6px;
    spacing: 2px;
}
QToolBar::separator {
    width: 1px;
    background: #c8c8c8;
    margin: 6px 5px;
}
QToolButton#ToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0;
    padding: 3px 5px 2px 5px;
    color: #000000;
    font-size: 8pt;
}
QToolButton#ToolButton:hover {
    background: #e8e8e8;
    border-color: #c8c8c8;
}
QToolButton#ToolButton:pressed {
    background: #dcdcdc;
    border-color: #b8b8b8;
}
QToolButton#ToolButton:disabled {
    color: #808080;
    background: transparent;
    border-color: transparent;
}

/* ---- category tree ------------------------------------------------------- */
QTreeWidget#CategoryTree {
    background: #ffffff;
    border: 1px solid #c8c8c8;
    border-radius: 0;
    padding: 2px;
    font-size: 9pt;
}
QTreeWidget#CategoryTree::item {
    height: 22px;
    padding: 0 2px;
    border: 0;
}
QTreeWidget#CategoryTree::item:hover { background: #f5f5f5; }
QTreeWidget#CategoryTree::item:selected {
    background: #f9f1ed;
    color: #3a3a90;
}
QTreeWidget#CategoryTree::branch {
    background: #ffffff;
}

/* ---- table (dense, classic grid) ------------------------------------------ */
QTableWidget#QueueTable {
    background: #ffffff;
    border: 1px solid #c8c8c8;
    gridline-color: #dcdcdc;
    selection-background-color: #f9f1ed;
    selection-color: #000000;
    alternate-background-color: #ffffff;
    font-size: 9pt;
}
QTableWidget#QueueTable::item {
    padding: 1px 6px;
    border: 0;
}
QTableWidget#QueueTable::item:selected {
    background: #f9f1ed;
    color: #000000;
}
QHeaderView::section {
    background: #f0f0f0;
    color: #000000;
    border: 0;
    border-right: 1px solid #c8c8c8;
    border-bottom: 1px solid #c8c8c8;
    padding: 4px 6px;
    font-weight: 400;
    font-size: 9pt;
}
QTableCornerButton::section {
    background: #f0f0f0;
    border: 0;
    border-right: 1px solid #c8c8c8;
    border-bottom: 1px solid #c8c8c8;
}

/* ---- status bar ------------------------------------------------------------ */
QStatusBar {
    background: #f0f0f0;
    border-top: 1px solid #c8c8c8;
    color: #000000;
    font-size: 8.5pt;
}
QStatusBar::item { border: 0; }
QLabel#StatusPart { color: #000000; padding: 1px 8px; }
QLabel#StatusPart[muted="true"] { color: #808080; }
QLabel#StatusDot {
    border-radius: 4px;
    background: #808080;
}
QLabel#StatusDot[state="ready"]     { background: #808080; }
QLabel#StatusDot[state="running"]   { background: #4f46e5; }
QLabel#StatusDot[state="completed"] { background: #12b76a; }
QLabel#StatusDot[state="stopped"]   { background: #f79009; }
QLabel#StatusDot[state="failed"]    { background: #f04438; }
QLabel#StatusDot[state="off"]       { background: #808080; }
QLabel#StatusDot[state="active"]    { background: #12b76a; }
QLabel#StatusDot[state="searching"] { background: #f79009; }
QLabel#StatusDot[state="grading"]   { background: #4f46e5; }

/* ---- cards (flat, square, thin borders — for panel pages) ------------------ */
QFrame#Card, QFrame#StatCard, QFrame#ProviderCard, QFrame#WorkerChip,
QFrame#FeedRow, QFrame#QueueRow, QFrame#ModelRow, QFrame#ConsoleCard,
QFrame#SegmentBar {
    background: #ffffff;
    border: 1px solid #c8c8c8;
    border-radius: 0;
}
QLabel#CardCaption {
    color: #808080;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 1px;
}

/* ---- buttons (classic rectangular) ----------------------------------------- */
QPushButton {
    min-height: 24px;
    padding: 2px 12px;
    background: #f5f5f5;
    color: #000000;
    border: 1px solid #c8c8c8;
    border-radius: 0;
    font-size: 9pt;
}
QPushButton:hover { background: #ececec; border-color: #b8b8b8; }
QPushButton:pressed { background: #dcdcdc; }
QPushButton:disabled { background: #f0f0f0; color: #808080; border-color: #dcdcdc; }
QPushButton:focus { border: 1px solid #3a3a90; }
QPushButton#Primary {
    background: #4f46e5;
    color: #ffffff;
    border: 1px solid #4f46e5;
}
QPushButton#Primary:hover { background: #4338ca; }
QPushButton#Primary:pressed { background: #3730a3; }
QPushButton#Primary:disabled { background: #b7c0f5; border-color: #b7c0f5; color: #ffffff; }
QPushButton#Danger {
    background: #f04438;
    color: #ffffff;
    border: 1px solid #f04438;
}
QPushButton#Danger:hover { background: #d92d20; }
QPushButton#Danger:disabled { background: #f0b0aa; border-color: #f0b0aa; color: #ffffff; }
QPushButton#Ghost {
    background: transparent;
    border: 1px solid transparent;
    color: #4f46e5;
}
QPushButton#Ghost:hover { background: #ececf8; border-color: #d5d5f0; }

/* ---- inputs ------------------------------------------------------------------ */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit,
QListWidget, QTableWidget, QTreeWidget {
    background: #ffffff;
    color: #000000;
    border: 1px solid #c8c8c8;
    border-radius: 0;
    padding: 2px 6px;
    selection-background-color: #3a3a90;
    selection-color: #ffffff;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QListWidget:focus, QTableWidget:focus, QTreeWidget:focus {
    border: 1px solid #3a3a90;
}
QComboBox { min-height: 22px; }
QComboBox::drop-down { border: 0; width: 20px; }
QComboBox::down-arrow { image: none; }
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #c8c8c8;
    selection-background-color: #e8e8e8;
    selection-color: #000000;
}

/* ---- pipeline stage stepper --------------------------------------------------- */
QLabel#StageDot {
    border-radius: 7px;
    background: #dcdcdc;
    border: 1px solid #c8c8c8;
}
QLabel#StageDot[state="todo"]   { background: #dcdcdc; }
QLabel#StageDot[state="active"] { background: #4f46e5; }
QLabel#StageDot[state="done"]   { background: #12b76a; }
QLabel#StageName { color: #585858; font-size: 8.5pt; font-weight: 700; }
QLabel#StageName[state="active"] { color: #3a3a90; }
QLabel#StageName[state="done"]   { color: #067647; }
QLabel#StageCount { color: #808080; font-size: 8pt; }
QLabel#StageCount[state="active"] { color: #3a3a90; }
QFrame#StageLine { background: #dcdcdc; border: 0; max-height: 3px; }
QFrame#StageLine[state="done"]   { background: #a6f4c5; }
QFrame#StageLine[state="active"] { background: #c7d2fe; }

/* ---- progress bars -------------------------------------------------------------- */
QProgressBar {
    background: #ffffff;
    border: 1px solid #c8c8c8;
    border-radius: 0;
    min-height: 12px;
    max-height: 12px;
    text-align: center;
    color: #000000;
    font-size: 8pt;
}
QProgressBar::chunk { background: #4f46e5; border: 0; }
QProgressBar#QueueProgress {
    background: #ffffff;
    border: 1px solid #dcdcdc;
    min-height: 10px;
    max-height: 10px;
    text-align: center;
    color: transparent;
    font-size: 1px;
}
QProgressBar#QueueProgress::chunk { background: #4f46e5; }

/* ---- queue table rows (panel page reuse) ------------------------------------------ */
QFrame#QueueRow { border: 1px solid #dcdcdc; }
QFrame#QueueRow:hover { background: #f7f7f7; }
QFrame#QueueRow[status="running"] { background: #fdf9ef; border-color: #e0c890; }
QFrame#QueueRow[status="failed"]  { background: #fdf5f4; border-color: #e0b8b4; }
QLabel#QueueTitle { color: #000000; font-size: 9pt; font-weight: 600; }
QLabel#Pill {
    border: 1px solid #c8c8c8;
    padding: 0 8px;
    font-size: 8pt;
    font-weight: 700;
    color: #585858;
    background: #f5f5f5;
    border-radius: 0;
}
QLabel#Pill[status="queued"]  { color: #3a3a90; background: #ececf8; border-color: #c5c5e8; }
QLabel#Pill[status="running"] { color: #b54708; background: #fdf3e0; border-color: #e8d0a0; }
QLabel#Pill[status="done"]    { color: #067647; background: #e8f8ef; border-color: #b0e0c8; }
QLabel#Pill[status="failed"]  { color: #b42318; background: #fdecea; border-color: #e8b8b4; }
QLabel#Pill[status="partial"] { color: #b42318; background: #fdecea; border-color: #e8b8b4; }
QLabel#Pill[status="skipped"] { color: #585858; background: #f0f0f0; border-color: #dcdcdc; }

/* ---- providers page ---------------------------------------------------------------- */
QFrame#ProviderCard[health="online"]   { border-color: #a6f4c5; }
QFrame#ProviderCard[health="degraded"] { border-color: #e8d0a0; }
QFrame#ProviderCard[health="offline"]  { border-color: #e8b8b4; }
QLabel#ProviderName { color: #000000; font-size: 10pt; font-weight: 700; }
QLabel#HealthTag {
    border: 1px solid #c8c8c8;
    padding: 0 8px;
    font-size: 8pt;
    font-weight: 700;
    border-radius: 0;
}
QLabel#HealthTag[state="online"]   { color: #067647; background: #e8f8ef; border-color: #b0e0c8; }
QLabel#HealthTag[state="degraded"] { color: #b54708; background: #fdf3e0; border-color: #e8d0a0; }
QLabel#HealthTag[state="offline"]  { color: #b42318; background: #fdecea; border-color: #e8b8b4; }
QLabel#HealthTag[state="unknown"]  { color: #585858; background: #f5f5f5; border-color: #c8c8c8; }
QLabel#ModelVal { color: #000000; font-size: 9pt; }
QLabel#ModelKey { color: #808080; font-size: 8.5pt; }
QFrame#WorkerChip[status="running"] { border-color: #c5c5e8; background: #f7f8fd; }
QFrame#WorkerChip[status="failed"]  { border-color: #e8b8b4; background: #fdf5f4; }
QFrame#WorkerChip[status="done"]    { border-color: #b0e0c8; background: #f6fdf9; }
QLabel#WorkerTitle { color: #000000; font-size: 9pt; font-weight: 700; }
QLabel#WorkerDetail { color: #808080; font-size: 8pt; }
QLabel#WorkerState {
    border: 1px solid #c8c8c8;
    padding: 0 8px;
    font-size: 8pt;
    font-weight: 700;
    color: #585858;
    background: #f5f5f5;
    border-radius: 0;
}
QLabel#WorkerState[status="running"] { color: #3a3a90; background: #ececf8; }
QLabel#WorkerState[status="failed"]  { color: #b42318; background: #fdecea; }
QLabel#WorkerState[status="done"]    { color: #067647; background: #e8f8ef; }

/* ---- activity page -------------------------------------------------------------------- */
QPushButton#Segment {
    background: #f5f5f5;
    border: 1px solid #c8c8c8;
    border-radius: 0;
    padding: 3px 14px;
    min-height: 22px;
    color: #585858;
    font-size: 9pt;
}
QPushButton#Segment:hover { background: #ececec; color: #000000; }
QPushButton#Segment:checked { background: #4f46e5; color: #ffffff; border-color: #4f46e5; }
QTextEdit#ConsoleEdit {
    background: #1c2430;
    color: #d0d7e2;
    border: 1px solid #c8c8c8;
    font-family: "Consolas", "Cascadia Mono", monospace;
    font-size: 9pt;
    selection-background-color: #37415c;
    selection-color: #ffffff;
    padding: 6px;
}
QListWidget#FeedList { background: transparent; border: 0; padding: 0; }
QListWidget#FeedList::item { border: 0; margin: 2px 0; padding: 0; }
QListWidget#FeedList::item:selected { background: #e8e8e8; }
QFrame#FeedRow[decision="YES"]    { border-color: #b0e0c8; }
QFrame#FeedRow[decision="NO"]     { border-color: #e8b8b4; }
QFrame#FeedRow[decision="REVIEW"] { border-color: #e8d0a0; }
QLabel#FeedBadge {
    border: 1px solid #c8c8c8;
    padding: 1px 8px;
    font-size: 8pt;
    font-weight: 700;
    border-radius: 0;
}
QLabel#FeedBadge[decision="YES"]    { color: #067647; background: #e8f8ef; }
QLabel#FeedBadge[decision="NO"]     { color: #b42318; background: #fdecea; }
QLabel#FeedBadge[decision="REVIEW"] { color: #b54708; background: #fdf3e0; }
QLabel#FeedBadge[decision="ERROR"]  { color: #b42318; background: #fdecea; }
QLabel#FeedTitle { color: #000000; font-size: 9pt; font-weight: 700; }

/* ---- dialog-family widgets (settings / answer keys / audit / auto-run) ------ */
QGroupBox {
    background: #ffffff;
    border: 1px solid #c8c8c8;
    border-radius: 0;
    margin-top: 11px;
    padding: 8px 6px 6px 6px;
    font-weight: 600;
    font-size: 9pt;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    background: #ffffff;
    color: #000000;
}
QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #c8c8c8;
    border-radius: 0;
    top: -1px;
}
QTabBar::tab {
    background: #f0f0f0;
    color: #000000;
    border: 1px solid #c8c8c8;
    border-bottom: 0;
    padding: 4px 14px;
    margin-right: 1px;
    font-size: 9pt;
}
QTabBar::tab:selected {
    background: #ffffff;
    font-weight: 600;
}
QTabBar::tab:hover:!selected { background: #e8e8e8; }
QLabel#Section { color: #000000; font-size: 10pt; font-weight: 700; }
QFrame#Panel {
    background: #ffffff;
    border: 1px solid #c8c8c8;
    border-radius: 0;
}
QPushButton#Secondary {
    background: #f5f5f5;
    color: #000000;
    border: 1px solid #c8c8c8;
}
QPushButton#Secondary:hover { background: #ececec; }
QListWidget#SourceList {
    background: #ffffff;
    border: 1px solid #c8c8c8;
    padding: 2px;
}
QListWidget#SourceList::item {
    min-height: 22px;
    padding: 1px 4px;
    margin: 0;
    color: #000000;
}
QListWidget#SourceList::item:hover { background: #f5f5f5; }
QListWidget#SourceList::item:selected { background: #f9f1ed; color: #3a3a90; }
QRadioButton { spacing: 6px; min-height: 18px; }
QRadioButton::indicator { width: 13px; height: 13px; border: 1px solid #c8c8c8; border-radius: 7px; }
QRadioButton::indicator:checked { background: #4f46e5; border: 1px solid #4f46e5; }
QDateTimeEdit { min-height: 22px; }
QDialogButtonBox QPushButton { min-width: 84px; }

/* ---- misc --------------------------------------------------------------------------------- */
QMenu {
    background: #ffffff;
    border: 1px solid #c8c8c8;
    padding: 2px;
    font-size: 9pt;
    border-radius: 0;
}
QMenu::item { padding: 5px 24px 5px 12px; border-radius: 0; }
QMenu::item:selected { background: #e8e8e8; color: #000000; }
QMenu::item:disabled { color: #808080; }
QMenu::separator { height: 1px; background: #dcdcdc; margin: 4px 8px; }
QToolTip {
    background: #ffffe1;
    color: #000000;
    border: 1px solid #808080;
    border-radius: 0;
    padding: 4px;
    font-size: 9pt;
}
QScrollBar:vertical { background: #f0f0f0; width: 16px; margin: 0; border: 0; }
QScrollBar::handle:vertical { background: #c8c8c8; min-height: 24px; border: 1px solid #b0b0b0; }
QScrollBar::handle:vertical:hover { background: #b0b0b0; }
QScrollBar:horizontal { background: #f0f0f0; height: 16px; margin: 0; border: 0; }
QScrollBar::handle:horizontal { background: #c8c8c8; min-width: 24px; border: 1px solid #b0b0b0; }
QScrollBar::handle:horizontal:hover { background: #b0b0b0; }
QScrollBar::add-line, QScrollBar::sub-line {
    width: 16px; height: 16px;
    background: #f0f0f0;
    border: 1px solid #c8c8c8;
}
QScrollBar::add-line:hover, QScrollBar::sub-line:hover { background: #e0e0e0; }
QCheckBox, QRadioButton { spacing: 6px; min-height: 18px; }
QCheckBox::indicator { width: 13px; height: 13px; border: 1px solid #c8c8c8; }
QCheckBox::indicator:checked { background: #4f46e5; border: 1px solid #4f46e5; }
QSplitter::handle { background: #f0f0f0; }
QSplitter::handle:hover { background: #c5c5e8; }
