{
    "models": {
        "judge": [
            "llama3.1:8b"
        ]
    },
    "jury_models": {
        "semantic_judge": "llama3.1:8b",
        "concept_judge": "llama3.1:8b",
        "factual_judge": "llama3.1:8b",
        "strict_judge": "llama3.1:8b",
        "misconception_judge": "llama3.1:8b",
        "language_filter": "gpt-oss:latest"
    },
    "rubric_model": "llama3.1:8b",
    "embedding_model": "mxbai-embed-large",
    "reasoning_model": "llama3.1:8b",
    "leniency": "extreme",
    "leniency_note": "options: extreme, lenient, balanced, strict",
    "evaluator": "ai_evaluator_semantic",
    "generate_report": false,
    "enable_pipeline_workers": true,
    "deterministic_worker_count": 4,
    "ai_worker_count": 1,
    "worker_queue_size": 1200,
    "global_prefetch_mode": true,
    "dispatch_mode": "global",
    "global_prefetch_workers": 6,
    "forms_expensive_reads_per_minute": 160,
    "semantic_similarity_workers": 5,
    "hybrid_prepare_workers": 4,
    "hybrid_prefetch_size": 1000,
    "producer_det_queue_high_watermark": 900,
    "producer_det_queue_low_watermark": 450,
    "deterministic_check_timeout_seconds": 6,
    "dispatcher_stall_timeout_seconds": 420,
    "task_builder_log_enabled": true,
    "task_builder_log_path": "task_builder_metrics.jsonl",
    "max_parallel_workers": 8,
    "adaptive_min_workers": 2,
    "adaptive_max_workers": 12,
    "adaptive_target_latency_ms": 15000,
    "adaptive_timeout_rate_threshold": 0.2,
    "adaptive_chunk_size": 12,
    "max_concurrent_jury_answers": 1,
    "jury_semaphore_acquire_timeout_seconds": 45,
    "enable_async_judges": false,
    "sync_judge_parallelism": 1,
    "judge_timeout_seconds": 45,
    "judge_http_timeout_seconds": 65,
    "embedding_timeout_seconds": 45,
    "embedding_connect_timeout_seconds": 10,
    "semantic_similarity_batch_timeout_seconds": 90,
    "rubric_timeout_seconds": 60,
    "rubric_connect_timeout_seconds": 10,
    "batch_size": 15,
    "numeric_tolerance": 0.01,
    "max_latency_per_answer_seconds": 45,
    "enable_reflection": false,
    "misconception_penalty": 0.4,
    "retry_attempts": 3,
    "confidence_thresholds": {
        "auto_accept": 0.9,
        "auto_reject": 0.35
    },
    "embedding_thresholds": {
        "auto_accept": 0.9,
        "auto_reject": 0.42,
        "send_to_jury": [
            0.42,
            0.9
        ]
    },
    "consensus_weights": {
        "semantic_similarity": 0.45,
        "concept_coverage": 0.25,
        "factual_accuracy": 0.15,
        "strict_judge": 0.05,
        "language_noise": 0.0,
        "embedding": 0.1
    },
    "ollama_options": {
        "judge_num_ctx": 2048,
        "judge_num_predict": 512,
        "embedding_num_ctx": 1024,
        "rubric_num_ctx": 512,
        "rubric_num_predict": 512,
        "fallback_num_ctx": 2048,
        "fallback_num_predict": 256,
        "num_gpu": -1,
        "num_batch": 512,
        "num_thread": 12,
        "keep_alive": "30m"
    },
    "early_exit": {
        "enabled": true,
        "min_judges": 3,
        "agreement_confidence": 0.9
    },
    "persist_result_cache": false,
    "grading_mode": "Whole Form",
    "heartbeat_timeout": 30,
    "heartbeat_interval": 10,
    "heartbeat_max_restarts": 5,
    "detailed_log_text_path": "logs/runtime_detailed.log",
    "detailed_log_json_path": "logs/runtime_detailed.jsonl",
    "hang_diagnostics_enabled": true,
    "hang_diag_poll_interval_seconds": 5,
    "hang_diag_stale_seconds": 120,
    "hang_diag_dump_cooldown_seconds": 30,
    "hang_diag_events_path": "logs/hang_events.jsonl",
    "hang_diag_stackdump_path": "logs/hang_stack_dumps.log",
    "console_log_enabled": true,
    "console_log_min_level": "INFO",
    "execution_mode": "Math: deterministic checks + semantic judge only (recommended)",
    "max_concurrent_judge_http": 1,
    "max_concurrent_embedding_http": 1,
    "ai_stall_timeout_seconds": 300,
    "judge_total_hard_timeout_seconds": 55,
    "jury_circuit_break_seconds": 900,
    "judge_prewarm_enabled": true,
    "judge_prewarm_timeout_seconds": 20,
    "active_judge_roles": [
        "semantic_judge"
    ]
}
